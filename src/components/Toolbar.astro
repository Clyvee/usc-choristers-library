<div class="meta">
  <span id="count" aria-live="polite">&mdash;</span>
  <span style="display:flex;align-items:center;gap:1.3rem;">
    <button class="clearall" id="clearBtn" type="button" hidden>Clear</button>
    <span class="views" id="views" role="group" aria-label="View" hidden>
      <button id="listBtn" type="button" aria-pressed="true">List</button>
      <button id="cardBtn" type="button" aria-pressed="false">Cards</button>
    </span>
  </span>
</div>
